# Database and application URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe subscriptions. Prefer the exact lookup keys below; the *_PRICE_ID
# variables are optional pinned overrides. Additional Mail Volume uses meter
# event multivrs_mail_email_units. Non-mail overages use the separate
# multivrs_usage_overage_cents meter, where one reported unit is one cent.
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_replace_with_subscription_webhook_secret
STRIPE_HOBBY_MONTHLY_LOOKUP_KEY=multivrs_hobby_monthly
STRIPE_PRO_MONTHLY_LOOKUP_KEY=multivrs_pro_monthly
STRIPE_DEVELOPER_SEAT_PRICE_ID=
STRIPE_SPEED_INSIGHTS_PRICE_ID=
STRIPE_WEB_ANALYTICS_PLUS_PRICE_ID=
STRIPE_OBSERVABILITY_PLUS_PRICE_ID=
STRIPE_MAIL_VOLUME_PRICE_ID=
STRIPE_MAIL_EMAIL_UNITS_PRICE_ID=
STRIPE_USAGE_OVERAGE_CENTS_PRICE_ID=
CRON_SECRET=replace-with-a-different-random-secret

# Outbound provider. This key must have Full access because Multivrs creates
# and verifies customer sending domains as well as sending their messages.
RESEND_API_KEY=re_test_or_live_key
RESEND_REGION=us-east-1
RESEND_DOMAIN_WEBHOOK_SECRET=whsec_replace_with_domain_webhook_secret

# Cloudflare mail worker
MAIL_WORKER_URL=http://localhost:8789
MAIL_WORKER_SECRET=replace-with-at-least-32-random-bytes

# Signed ingress from the receiving gateway and provider-event adapter
MAIL_INBOUND_WEBHOOK_SECRET=replace-with-a-different-random-secret
MAIL_PROVIDER_WEBHOOK_SECRET=replace-with-a-different-random-secret
MAIL_WEBHOOK_MASTER_KEY=replace-with-a-stable-32-byte-master-key

# Registrar and DNS provider for domains bought through Multivrs. Use the local
# sandbox driver in development instead of real Openprovider credentials.
OPENPROVIDER_API_URL=https://api.openprovider.eu
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_SANDBOX_DRIVER=local

# Customer SMTP submission gateway (deploy apps/mail-smtp on port 587)
MULTIVRS_SMTP_HOST=smtp.multivrs.space
CONTROL_PLANE_URL=http://localhost:3000
SMTP_PORT=587
SMTP_TLS_CERT="-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"
SMTP_TLS_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Local gateway only; never enable this in production
SMTP_ALLOW_INSECURE_LOCAL=false

# Cloudflare delivery, content storage, runtime configuration, and usage
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ANALYTICS_API_TOKEN=
CLOUDFLARE_RUNTIME_KV_NAMESPACE_ID=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=multivrs-artifacts
R2_CONTENT_BUCKET_NAME=multivrs-content
MULTIVRS_SERVE_TOKEN=replace-with-a-different-random-secret
MULTIVRS_FIREWALL_BYPASS_SECRET=replace-with-a-long-random-secret
GITHUB_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
MULTIVRS_WORKFLOW_CONTROL_SECRET=replace-with-a-different-long-random-secret
CLOUDFLARE_WORKFLOW_WORKER_URL=https://multivrs-serve.example.workers.dev
# Set the Serve and Compute Workers' CONTROL_PLANE_TOKEN secret to
# MULTIVRS_SERVE_TOKEN. Set the Serve Worker's WORKFLOW_CONTROL_SECRET secret
# to MULTIVRS_WORKFLOW_CONTROL_SECRET.
# Use this exact same value for the Serve Worker's BLOB_SIGNING_SECRET.
MULTIVRS_BLOB_SIGNING_SECRET=replace-with-at-least-32-random-bytes
