{
  "name": "multivrs",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:convex": "turbo run dev --filter=@repo/backend",
    "dev:serve": "bun run --cwd apps/serve-worker dev",
    "dev:build-worker": "bun run --cwd apps/build-worker dev",
    "dev:compute": "bun run --cwd apps/compute-worker dev",
    "dev:mail-worker": "bun run --cwd apps/mail-worker dev",
    "dev:mail-inbound": "bun run --cwd apps/mail-inbound dev",
    "dev:mail-smtp": "bun run --cwd apps/mail-smtp dev",
    "deploy:serve": "bun run --cwd apps/serve-worker deploy",
    "deploy:serve:dry": "bun run --cwd apps/serve-worker deploy:dry",
    "deploy:build-worker": "bun run --cwd apps/build-worker deploy",
    "deploy:compute": "bun run --cwd apps/compute-worker deploy",
    "deploy:mail-worker": "bun run --cwd apps/mail-worker deploy",
    "deploy:mail-inbound": "bun run --cwd apps/mail-inbound deploy",
    "deploy:convex": "bun run --cwd packages/backend deploy",
    "deploy:build-worker:dry": "bun run --cwd apps/build-worker deploy:dry",
    "deploy:compute:dry": "bun run --cwd apps/compute-worker deploy:dry",
    "deploy:mail-worker:dry": "bun run --cwd apps/mail-worker deploy:dry",
    "deploy:mail-inbound:dry": "bun run --cwd apps/mail-inbound deploy:dry",
    "lint": "turbo run lint",
    "format": "biome check --fix .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "test": "bun test ./test",
    "test:all": "turbo run test",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "build:rust": "cargo build --workspace --release",
    "gate": "bun test ./test && cargo test --workspace"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@multivrs/build-utils": "*",
    "@multivrs/builder-next": "*",
    "@multivrs/builder-runtime": "*",
    "@multivrs/builder-swift-rust": "*",
    "@multivrs/client": "*",
    "@multivrs/config": "*",
    "@multivrs/edge": "*",
    "@multivrs/error-utils": "*",
    "@multivrs/firewall": "*",
    "@multivrs/frameworks": "*",
    "@multivrs/fs-detectors": "*",
    "@multivrs/functions": "*",
    "@multivrs/mcp-adapter": "*",
    "@multivrs/routing-utils": "*",
    "@multivrs/static-build": "*",
    "@types/bun": "^1.3.5",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=25.8.1"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
