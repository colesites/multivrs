{
  "name": "multivrs",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:convex": "turbo run dev --filter=@repo/backend",
    "dev:serve": "bun run --cwd apps/serve-worker dev",
    "dev:build-worker": "bun run --cwd apps/build-worker dev",
    "dev:compute": "bun run --cwd apps/compute-worker dev",
    "dev:mail-worker": "bun run --cwd apps/mail-worker dev",
    "dev:mail-smtp": "bun run --cwd apps/mail-smtp dev",
    "dev:vrs-pay-api": "bun run --cwd apps/vrs-pay-api dev",
    "deploy:serve": "bun run --cwd apps/serve-worker deploy",
    "deploy:serve:dry": "bun run --cwd apps/serve-worker deploy:dry",
    "deploy:build-worker": "bun run --cwd apps/build-worker deploy",
    "deploy:compute": "bun run --cwd apps/compute-worker deploy",
    "deploy:mail-worker": "bun run --cwd apps/mail-worker deploy",
    "deploy:convex": "bun run --cwd packages/backend deploy",
    "db:migrate:deploy": "bun run --cwd apps/web db:migrate:deploy",
    "sanity:seed:pricing": "bun apps/web/scripts/seed-pricing-comparison.ts",
    "sanity:seed:pricing:force": "bun apps/web/scripts/seed-pricing-comparison.ts --force",
    "sanity:seed:pricing:check": "bun apps/web/scripts/seed-pricing-comparison.ts --dry-run",
    "deploy:build-worker:dry": "bun run --cwd apps/build-worker deploy:dry",
    "deploy:compute:dry": "bun run --cwd apps/compute-worker deploy:dry",
    "deploy:mail-worker:dry": "bun run --cwd apps/mail-worker deploy:dry",
    "lint": "turbo run lint",
    "format": "biome check --fix .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "test": "bun test ./test",
    "test:all": "turbo run test",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "build:rust": "cargo build --workspace --release",
    "gate": "bun test ./test && cargo test --workspace"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@repo/biome-config": "*",
    "@repo/typescript-config": "*",
    "@multivrs/build-utils": "*",
    "@multivrs/builder-next": "*",
    "@multivrs/builder-runtime": "*",
    "@multivrs/builder-swift-rust": "*",
    "@multivrs/client": "*",
    "@multivrs/config": "*",
    "@multivrs/edge": "*",
    "@multivrs/error-utils": "*",
    "@multivrs/firewall": "*",
    "@multivrs/frameworks": "*",
    "@multivrs/fs-detectors": "*",
    "@multivrs/functions": "*",
    "@multivrs/mcp-adapter": "*",
    "@multivrs/routing-utils": "*",
    "@multivrs/static-build": "*",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vrs-pay/core": "*",
    "@vrs-pay/js": "*",
    "@vrs-pay/react": "*",
    "@vrs-pay/sdk": "*",
    "stripe": "^22.3.2",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=25.8.1"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@module-federation/dts-plugin": "^2.9.2",
    "adm-zip": "^0.6.1",
    "baseline-browser-mapping": "^2.11.28",
    "browserslist": "^4.29.3",
    "dompurify": "^3.4.16",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.13",
    "ip-address": "^10.7.4",
    "markdown-it": "^14.3.2",
    "mysql2": "^3.24.5",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "smol-toml": "^1.9.1",
    "source-map-js": "^1.2.2",
    "ws": "^8.22.0"
  }
}
