{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "extends": ["./biome.json"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/next-env.d.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noUnknownAtRules": "off"
      },
      "a11y": {
        "recommended": true
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  }
}
