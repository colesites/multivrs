# Copy to .env.local. Generate a dev key with: bun run dev:key
PORT=4300
VRS_DEV_SECRET_KEY=

# Dashboard login (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4300
VRS_DASHBOARD_URL=http://localhost:3210
# Optional social sign-in; callback URLs are {BETTER_AUTH_URL}/auth/callback/github|google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VRS Pay Supabase (transaction pooler 6543 for the app, session pooler 5432 for migrations)
DATABASE_URL=
DIRECT_URL=
# Stripe: one server serves test and live mode. STRIPE_SECRET_KEY fills the mode
# its key belongs to (sk_test_ → test); the TEST/LIVE pairs set a mode explicitly.
# A mode without a key can't take payments. Webhook secrets from
# `bun run stripe:listen` or the Stripe Dashboard (one endpoint per mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# Password-reset email via AWS SES (same setup as Multivrs). Without these,
# local dev prints the reset link in the API terminal instead.
VRS_EMAIL_FROM="VRS Pay <no-reply@multivrs.space>"
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Automatic ID checks (no manual review). One check covers test and live mode,
# like account activation on Stripe, so servers with a database only run real
# checks. Without any of these, a database server refuses ID checks; local
# dev without a database passes any well-formed number.
# Smile ID looks up BVN, NIN, Ghana Card, Kenyan and South African IDs at the
# issuer. Get keys at portal.usesmileid.com and enable Enhanced KYC for each
# ID type. SMILE_ID_ENV=sandbox only works without a database.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=production
# Everything else (UK, US, passports elsewhere) is a document and selfie check
# with Stripe Identity on the live Stripe key above. Turn on Identity in the
# Stripe Dashboard and add these events to the live webhook endpoint:
# identity.verification_session.processing, .verified, .requires_input, .canceled

# Encrypts merchants' bank details at rest (32 bytes, base64): openssl rand -base64 32
VRS_DATA_KEY=
