{
  "name": "vrs-pay-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "dev:key": "bun src/scripts/dev-key.ts",
    "merchant:create": "bun src/scripts/create-merchant.ts",
    "merchant:hold": "bun src/scripts/hold-merchant.ts",
    "stripe:listen": "bun src/scripts/stripe-listen.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "lint": "biome check .",
    "format": "biome check --fix .",
    "check-types": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1112.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vrs-pay/core": "*",
    "better-auth": "^1.6.20",
    "hono": "^4.12.26",
    "pg": "^8.23.0",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/biome-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "5.9.2"
  }
}
