enum CheckoutMode {
  payment
  subscription
}

enum CheckoutSessionStatus {
  open
  complete
  expired
}

model CheckoutSession {
  id                String                @id
  merchantId        String                @map("merchant_id")
  mode              Mode
  status            CheckoutSessionStatus @default(open)
  checkoutMode      CheckoutMode          @default(payment) @map("checkout_mode")
  customerId        String?               @map("customer_id")
  paymentLinkId     String?               @map("payment_link_id")
  subscriptionId    String?               @map("subscription_id")
  amount            BigInt
  currency          String                @db.Char(3)
  paymentMethod     String                @map("payment_method")
  description       String?
  provider          Provider
  providerReference String                @map("provider_reference")
  url               String
  platformFee       BigInt                @map("platform_fee")
  successUrl        String                @map("success_url")
  cancelUrl         String                @map("cancel_url")
  customerEmail     String?               @map("customer_email")
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  Payment?

  @@unique([provider, providerReference])
  @@index([merchantId, mode, createdAt(sort: Desc)])
  @@map("checkout_sessions")
}

enum PaymentStatus {
  succeeded
  partially_refunded
  refunded
}

model Payment {
  id                String        @id
  merchantId        String        @map("merchant_id")
  mode              Mode
  checkoutSessionId String?       @unique @map("checkout_session_id")
  provider          Provider
  /// The connected account / subaccount the charge was made on.
  providerAccountId String        @map("provider_account_id")
  /// e.g. Stripe's PaymentIntent id (pi_…).
  providerReference String        @map("provider_reference")
  status            PaymentStatus @default(succeeded)
  /// What the buyer paid, tax included.
  amount            BigInt
  amountRefunded    BigInt        @default(0) @map("amount_refunded")
  /// The part of amount that is tax, owed to tax authorities.
  amountTax         BigInt        @default(0) @map("amount_tax")
  currency          String        @db.Char(3)
  platformFee       BigInt        @map("platform_fee")
  providerFee       BigInt        @map("provider_fee")
  customerEmail     String?       @map("customer_email")
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  refunds         Refund[]
  disputes        Dispute[]

  @@unique([provider, providerReference])
  @@index([merchantId, mode, createdAt(sort: Desc)])
  @@map("payments")
}

enum RefundStatus {
  pending
  succeeded
  failed
}

model Refund {
  id                String       @id
  merchantId        String       @map("merchant_id")
  mode              Mode
  paymentId         String       @map("payment_id")
  provider          Provider
  providerReference String?      @map("provider_reference")
  status            RefundStatus @default(pending)
  amount            BigInt
  /// The part of amount that is tax returned to the buyer.
  amountTax         BigInt       @default(0) @map("amount_tax")
  currency          String       @db.Char(3)
  reason            String?
  metadata          Json         @default("{}")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerReference])
  @@index([paymentId])
  @@map("refunds")
}

enum DisputeStatus {
  open
  won
  lost
}

/// A chargeback: the buyer asked their bank to reverse a payment.
model Dispute {
  id                String        @id
  merchantId        String        @map("merchant_id")
  mode              Mode
  paymentId         String        @map("payment_id")
  provider          Provider
  /// e.g. Stripe's dispute id (dp_…).
  providerReference String        @map("provider_reference")
  status            DisputeStatus @default(open)
  amount            BigInt
  /// Taken out of the merchant's balance: the amount while held or lost, 0 once won.
  amountWithdrawn   BigInt        @default(0) @map("amount_withdrawn")
  /// The provider's dispute fee, charged to the merchant.
  fee               BigInt        @default(0)
  currency          String        @db.Char(3)
  reason            String?
  evidenceDueBy     DateTime?     @map("evidence_due_by")
  /// Bumped on every change, so concurrent webhooks can't double-post.
  version           Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerReference])
  @@index([merchantId, mode, createdAt(sort: Desc)])
  @@map("disputes")
}

enum PayoutStatus {
  pending
  paid
  failed
}

/// Money sent from a platform balance to a merchant's bank account.
model Payout {
  id                String       @id
  merchantId        String       @map("merchant_id")
  mode              Mode
  /// UTC day it was made for (YYYY-MM-DD): one per merchant, currency and day.
  payoutDay         String       @map("payout_day") @db.Char(10)
  /// Who sends it, e.g. paystack for Nigerian banks.
  rail              Provider
  /// The reference the transfer was sent with.
  providerReference String       @map("provider_reference")
  status            PayoutStatus @default(pending)
  /// What reaches the bank account.
  amount            BigInt
  /// The provider's transfer fee, charged to the merchant.
  fee               BigInt       @default(0)
  currency          String       @db.Char(3)
  bankName          String?      @map("bank_name")
  last4             String?
  failureMessage    String?      @map("failure_message")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, mode, currency, payoutDay])
  @@unique([rail, providerReference])
  @@index([merchantId, mode, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payouts")
}
