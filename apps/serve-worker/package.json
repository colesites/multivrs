{
  "name": "serve-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@multivrs/firewall": "*",
    "@multivrs/routing-utils": "*"
  },
  "scripts": {
    "configure:content-cors": "wrangler r2 bucket cors set multivrs-content --file r2-cors.json --force",
    "build:matcher": "bun run scripts/build-matcher.ts",
    "dev": "wrangler dev",
    "deploy": "bun run build:matcher && wrangler deploy && bun run configure:content-cors",
    "deploy:dry": "bun run build:matcher && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250201.0",
    "@repo/typescript-config": "*",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0",
    "zod": "^4.4.3"
  }
}
