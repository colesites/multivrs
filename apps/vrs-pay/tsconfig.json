{
  "extends": "swift-rust/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "globals.d.ts",
    ".swift-rust/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".swift-rust",
    ".turbo"
  ]
}
