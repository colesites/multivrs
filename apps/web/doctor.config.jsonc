{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        // React Doctor does not count Biome's package-based `extends` entry as
        // a source import. The dependency is used by biome.json and must stay.
        "files": ["package.json"],
        "rules": ["deslop/unused-dev-dependency"]
      }
    ]
  }
}
